# Copy this template to the private ../.env; fill real values there, outside Git.
# Django reads the active keys below in config/settings.py.
# Rails paths in these comments are relative to the separate Rails checkout.
# Look up deployed Rails values in its private .env or process environment.
# The named Ruby files show where those values are used; .env_sample lists only
# some keys and is not evidence of the values used by the running application.


## django PROJECT settings ------------------------------------------

# Required for the first installation, using saved page data

# Generate a fresh Django secret; do not copy the Rails secret.
# Rails counterpart: config/secrets.yml, SECRET_KEY_BASE.
DJANGO_SECRET_KEY="replace-with-a-new-django-secret"

# Keep False on the server. True is useful for local development error pages.
# Rails: config/environments/development.rb and production.rb set
# config.consider_all_requests_local; there is no matching Rails environment key.
DJANGO_DEBUG=False

# Add the Django site's hostname as a JSON string; omit its scheme and port.
# Rails: config/environments/development.rb and production.rb read HOST_URL
# for generated links. That is related information, not an allowed-hosts list;
# choose the Django hostname here rather than copying the complete Rails URL.
ALLOWED_HOSTS_JSON='["localhost", "127.0.0.1"]'

# Optional email settings follow the same order as config/settings.py. The
# current public-site work does not require email, so these use Django's defaults.
# Rails: no corresponding keys were found in the Rails application settings.
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=""
# EMAIL_HOST_PASSWORD=""
# DEFAULT_FROM_EMAIL="webmaster@example.com"

# Django's current database, cache, and log locations are set directly in
# config/settings.py: ../DBs/db.sqlite3, ../cache_dir, and ../logs/django.log.
# Arrange the writable directories separately; there are no environment keys
# for these locations yet. Prepared mode needs no Solr or VIVO connection.

# URL prefix for Django CSS, JavaScript, fonts, and other static files.
# Rails: config/environments/production.rb uses config.serve_static_files and
# optionally RELATIVE_URL for the whole app; neither is this Django setting.
# Confirm this prefix with the Django static-file setup. No direct Rails key.
STATIC_URL="/static/"

# Where Django collectstatic writes files. Choose the Django collection location.
# This example is relative to the process working directory; run collectstatic
# from the Django checkout or choose the installation's location in private .env.
# Rails: no direct environment key; Rails generates assets under public/assets.
STATIC_ROOT="../staticfiles"


## django APP settings ----------------------------------------------

# Existing optional settings

# Leave blank to avoid recording development visits as public-site analytics.
# Rails: app/views/layouts/application.html.erb, GOOGLE_ANALYTICS_KEY.
GOOGLE_ANALYTICS_KEY=""

# Keep this commented to use Django's existing link default, or fill it in
# in private .env to match the destination used by the Rails application.
# Manager link destination; preserving the link does not rebuild Manager.
# Rails: app/helpers/application_helper.rb, manager_url(), MANAGER_URL.
# MANAGER_URL=""

# Optional notice text shown on pages. Blank means no notice.
# Rails: app/controllers/home_controller.rb, search_controller.rb, and
# display_controller.rb, NOTICE_BANNER.
NOTICE_BANNER=""

# Feedback form URL template. Preserve the literal {LINK} placeholder.
# Rails: app/helpers/application_helper.rb, contact_us_url(). The URL is written
# directly in that function; there is no Rails CONTACT_US_URL_TEMPLATE key.
# CONTACT_US_URL_TEMPLATE=""

# The stub switch applies only to prototype mode. Prepared mode gets covers and
# images from its bundle. Live and replay modes use the source rows below.
# Rails: app/models/book_cover.rb, BOOK_COVER_STUB (true selects sample book rows).
# BOOK_COVER_STUB=true
# Rails: app/models/book_cover.rb, BOOK_COVER_BASE_PATH (an image URL prefix,
# despite its name). Set it for live or replay homepage books.
BOOK_COVER_BASE_PATH=""

# Choose where Django gets page data. This is one key with four possible values:
# prototype = existing sample pages; prepared = saved, already-arranged page data;
# replay = saved raw service responses; live = actual service requests.
# Selected search, person, organization, team, facet, document, and graph JSON
# routes use replay/live. Other pages use prepared data or return 503 in source
# modes. Use prepared for the first installation.
# Rails: no equivalent key; this choice supports the Django conversion work.
PAGE_DATA_MODE="prepared"

# Transfer the compatible prepared-data bundle separately from the repository.
# This relative path resolves against the Django checkout, not the launch directory.
# Rails: no equivalent key; the bundle was assembled from saved public responses.
PREPARED_FIXTURE_DIR="../prepared_fixture_data"

# Local development browser refresh; leave False for the server installation.
# Rails: no equivalent key. Django enables it only when DJANGO_DEBUG is also True.
DJANGO_BROWSER_RELOAD=False

# Source values for the supported search-to-profile and organization journey. Leave these empty in prepared mode.
# Source modes need the corresponding service or saved response manifest.

# Solr address including the selected core/collection.
# Rails: app/models/model_utils.rb and app/models/faculty.rb, SOLR_URL.
SOLR_URL=""

# Base address for profile and affiliation images. Django serves these through
# its own source-images route. Rails uses this value in its model helpers.
IMAGES_URL=""

# Base address serving profile CV PDFs. When set, matching CV links use Django's
# source-documents route so their redirects and bytes can be recorded and replayed.
DOCUMENTS_URL=""

# Replay reads an exact saved manifest outside Git and never contacts a source.
# The capture command creates the search-profile case; see docs/source_journey.md.
UPSTREAM_RECORDING_MANIFEST=""
UPSTREAM_RECORDING_CASE="search-profile"

# Rails highlight switch is not read by Django; this journey requests highlights.
# Rails: app/models/search.rb, SOLR_HIGHLIGHT.
# SOLR_HIGHLIGHT=

# VIVO address for original JSON-LD, Turtle, and RDF representations.
# Rails: app/controllers/individual_controller.rb, VIVO_BACKEND_URL;
# app/models/vitro_api.rb builds the requests from that value.
VIVO_BACKEND_URL=""

# Service supplying graphs and the lists of records with available graphs.
# Required for live profile JSON and graph JSON; replay uses exact saved responses.
# For public-page matching, use the public production visualization HTTPS root
# ending in /data/viz. Do not use staging visualization data as a public reference.
# Keep the exact address in the private .env file.
# Rails: app/models/coauthor_graph.rb and app/models/collab_graph.rb, VIZ_SERVICE_URL.
VIZ_SERVICE_URL=""

# Existing Rails switch used when displaying organization visualizations.
# Rails: app/controllers/display_controller.rb, VIZ_ENABLED.
VIZ_ENABLED=true

# Live homepage books use a separate MySQL account with SELECT permission for
# book_covers. Django's ordinary SQLite database remains separate. Install the
# staging or prod dependency group for the PyMySQL driver on that machine.
# Rails: config/database.yml supplies the corresponding database connection.
BOOK_COVER_DB_HOST=""
BOOK_COVER_DB_PORT=3306
BOOK_COVER_DB_NAME=""
BOOK_COVER_DB_USER=""
BOOK_COVER_DB_PASSWORD=""

# Browser challenge settings. These do not restrict access to the Django installation.
# The owner/system administrator provides that separate access restriction.
# Rails: app/controllers/bot_detect_controller.rb, CF_TURNSTILE_SITEKEY.
# Obtain a key suitable for the Django site's hostname when enabling this flow.
CF_TURNSTILE_SITEKEY=""
# Rails: app/controllers/bot_detect_controller.rb, CF_TURNSTILE_SECRET_KEY.
CF_TURNSTILE_SECRET_KEY=""
# Rails: app/controllers/bot_detect_controller.rb, ALLOWED_IP_RANGES.
# This is the challenge's exemption list, not Django ALLOWED_HOSTS_JSON.
ALLOWED_IP_RANGES=""

# TURNSTILE_ENABLED protects search GET requests after server-side verification.
# Leave it False in prepared and replay modes, which never contact Turnstile.
# A direct /challenge request returns 404 when it is disabled.
TURNSTILE_ENABLED=False
# Proposed capture switch, NOT READ YET. No matching Rails environment key.
# CAPTURE_UPSTREAM_RESPONSES would save selected source responses outside Git.
# This is new Django tooling; Rails has no corresponding key to copy.
# CAPTURE_UPSTREAM_RESPONSES=False

# A JSON file outside Git holding Rails-defined active-team details and fixed members.
TEAM_SOURCE_MANIFEST="/path/to/team_source_manifest.local.json"
