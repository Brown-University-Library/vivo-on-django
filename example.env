# Copy this template to private ../.env and fill real values there, outside Git.
# Quote values. Boolean strings use "true" or "false".
# Keys containing JSON hold JSON strings; file paths stay strings.
# See docs/source_journey.md for source settings.


## standard django settings -----------------------------------------

# Generate a fresh secret for this installation.
DJANGO_SECRET_KEY="replace-with-a-new-django-secret"
# Local error pages require "true". Keep "false" on the server.
DJANGO_DEBUG="false"
# Hostnames without scheme or port, as a JSON list.
ALLOWED_HOSTS_JSON='["localhost", "127.0.0.1"]'

# Optional email settings; omitted keys use Django defaults.
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT="587"
# EMAIL_USE_TLS="true"
# EMAIL_HOST_USER=""
# EMAIL_HOST_PASSWORD=""
# DEFAULT_FROM_EMAIL="webmaster@example.com"

# Database, cache, and logs use ../DBs/, ../cache_dir/, and ../logs/.
# Create the writable directories separately; these paths have no environment keys.
STATIC_URL="/static/"
# collectstatic destination, relative to the process working directory.
STATIC_ROOT="../staticfiles"


## app settings -----------------------------------------------------

# Blank prevents development visits from being sent to public-site analytics.
GOOGLE_ANALYTICS_KEY=""
# Leave commented to use the existing link default.
# MANAGER_URL=""
# Optional notice shown on pages.
NOTICE_BANNER=""
# Feedback link template; preserve the literal {LINK} placeholder.
# CONTACT_US_URL_TEMPLATE=""

# Local refresh requires DJANGO_DEBUG="true" too.
DJANGO_BROWSER_RELOAD="false"

## Source services

# Solr address including its core/collection. Required for application startup.
SOLR_URL=""
# Base addresses used by Django's source-image and source-document routes.
IMAGES_URL=""
DOCUMENTS_URL=""
# Original JSON-LD, Turtle, and RDF representations.
VIVO_BACKEND_URL=""
# Graph data and lists of records with available graphs.
VIZ_SERVICE_URL=""
# Organization visualization switch.
VIZ_ENABLED="true"
# External JSON file holding active-team details and fixed members.
TEAM_SOURCE_MANIFEST="../team_source_manifest.local.json"

## Subject librarian reports

# Private JSON definitions; relative paths resolve against the checkout.
REPORT_DEFINITIONS_PATH="../report_definitions.local.json"
REPORT_CACHE_TIMEOUT_SECONDS="28_800"  # 8 hours; 0 generates fresh downloads
# Local directory shared by workers using the same file-based cache.
REPORT_CACHE_LOCK_DIR="../cache_dir/report_locks"
# Trusted request-environment attribute supplied by the web server.
REPORTS_SHIB_ATTRIBUTE="Shibboleth-isMemberOf"
# Only for loopback runserver with DJANGO_DEBUG=true; default false.
REPORTS_ALLOW_LOCAL_DEVELOPMENT="false"

## Homepage books

# Image URL prefix for homepage books.
BOOK_COVER_BASE_PATH=""
# Separate MySQL account with SELECT permission for book_covers.
# Install the staging or prod group for the PyMySQL driver.
BOOK_COVER_DB_HOST=""
BOOK_COVER_DB_PORT="3306"
BOOK_COVER_DB_NAME=""
BOOK_COVER_DB_USER=""
BOOK_COVER_DB_PASSWORD=""

## Browser challenge

# These settings do not replace the site's separate access restriction.
CF_TURNSTILE_SITEKEY=""
CF_TURNSTILE_SECRET_KEY=""
# Comma-separated IP networks exempt from the challenge.
ALLOWED_IP_RANGES=""
# Automatically challenges search GET requests after server-side verification.
# With both keys set, /challenge works even if this is "false".
TURNSTILE_ENABLED="false"
